# ═══════════════════════════════════════════════════════════════════════════════
# JobPilot AI — PRODUCTION Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env.prod and fill ALL values before deploying.
# NEVER commit .env.prod to git.
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
API_PREFIX=/api/v1
LOG_DIR=/app/logs

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jobpilot:<STRONG_PASSWORD>@postgres:5432/jobpilot_db
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=<STRONG_PASSWORD>
POSTGRES_DB=jobpilot_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:<STRONG_REDIS_PASSWORD>@redis:6379
REDIS_PASSWORD=<STRONG_REDIS_PASSWORD>

# ── JWT — generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<GENERATE_48_CHAR_RANDOM_HEX>
JWT_EXPIRES_IN=7d

# ── CORS — exact domain, no trailing slash ───────────────────────────────────
CORS_ORIGIN=https://your-domain.com

# ── Web app ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_DEV_USER_ID=<USER_ID_FROM_DB_AFTER_SEED>

# ── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_EMAIL=<YOUR_LINKEDIN_EMAIL>
LINKEDIN_PASSWORD=<YOUR_LINKEDIN_PASSWORD>

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SESSION_DIR=/app/.sessions

# ── Resume ────────────────────────────────────────────────────────────────────
# Place Rahul_Jangid_Resume.pdf in the resume Docker volume before starting
RESUME_FILE_PATH=/app/resumes/Rahul_Jangid_Resume.pdf

# ── Screenshots ───────────────────────────────────────────────────────────────
SCREENSHOT_DIR=/app/screenshots
