{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "../..",
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@jobpilot/automation": ["../../workers/automation/src/index.ts"],
      "@jobpilot/automation/*": ["../../workers/automation/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../workers/automation/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
