# ═══════════════════════════════════════════════════════════════════════════════
# JobPilot AI — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in all values marked with <CHANGE_ME>
# 3. NEVER commit .env to git — it is in .gitignore
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── API Server ─────────────────────────────────────────────────────────────────
PORT=4000
API_PREFIX=/api/v1

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Dev default matches docker-compose.yml credentials exactly.
# For production, use a managed database URL (Railway, Supabase, RDS, etc.)
DATABASE_URL=postgresql://jobpilot:jobpilot_dev_password@localhost:5432/jobpilot_db

# Used only by docker-compose.prod.yml
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=jobpilot_db

# ── Redis ──────────────────────────────────────────────────────────────────────
# Dev default matches docker-compose.yml credentials exactly.
REDIS_URL=redis://:jobpilot_redis_password@localhost:6379

# Used only by docker-compose.prod.yml
REDIS_PASSWORD=<CHANGE_ME>

# ── JWT ────────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate a secure value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<CHANGE_ME_min_32_chars>
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────────────────
# In dev this is the Next.js dev server. In prod it's your domain.
CORS_ORIGIN=http://localhost:3000

# ── Next.js Web App ────────────────────────────────────────────────────────────
# Public vars (prefixed NEXT_PUBLIC_) are baked into the client bundle at build time.
# In dev the rewrite in next.config.ts handles proxying, so this isn't used.
# In prod set this to your actual API domain.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── LinkedIn Credentials ───────────────────────────────────────────────────────
# Used by the Playwright automation in Phase 2.
# IMPORTANT: Use a secondary LinkedIn account if possible — aggressive automation
# can trigger LinkedIn's bot detection on your primary account.
LINKEDIN_EMAIL=<CHANGE_ME>
LINKEDIN_PASSWORD=<CHANGE_ME>

# ── Playwright ─────────────────────────────────────────────────────────────────
# Absolute path to the directory where Playwright stores browser sessions.
# This directory is gitignored. Create it manually: mkdir -p .sessions
PLAYWRIGHT_SESSION_DIR=.sessions

# Run Playwright in headless mode in production, headed in dev for debugging.
PLAYWRIGHT_HEADLESS=true

# ── Resume ─────────────────────────────────────────────────────────────────────
# Absolute path to your resume PDF on the server.
# The filename must stay exactly: Rahul_Jangid_Resume.pdf
RESUME_FILE_PATH=/app/resumes/Rahul_Jangid_Resume.pdf
